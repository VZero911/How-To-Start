# Copy to .env and fill in your own values. NEVER commit a real .env or key.
# The API key is read from the environment at runtime — it is never written
# into the repository or a container image.

API_KEY=REPLACE_ME

# Hard spend cap in USD. The runner refuses any call that would cross it.
FLEET_BUDGET_USD=100.00

# Default model when a task does not specify one (see the guide for options).
FLEET_DEFAULT_MODEL=worker-model
